generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  name        String?
  createdAt   DateTime     @default(now())
  repertoires Repertoire[]
  reviewLogs  ReviewLog[]
}

// One row per graded move review — powers the activity heatmap.
model ReviewLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Repertoire {
  id         String      @id @default(cuid())
  name       String
  color      String
  createdAt  DateTime    @default(now())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  variations Variation[]
}

model Variation {
  id           String     @id @default(cuid())
  name         String
  repertoireId String
  repertoire   Repertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  moves        Move[]
  createdAt    DateTime   @default(now())
}

model Move {
  id          String    @id @default(cuid())
  fen         String
  san         String
  fromSq      String
  toSq        String
  order       Int
  comment     String?
  variationId String
  variation   Variation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  review      Review?
}

model Review {
  id         String   @id @default(cuid())
  level      Int      @default(0)
  nextReview DateTime @default(now())
  lastReview DateTime @default(now())
  createdAt  DateTime @default(now())
  moveId     String   @unique
  move       Move     @relation(fields: [moveId], references: [id], onDelete: Cascade)
}
