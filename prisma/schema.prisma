generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())

  repertoires Repertoire[]
  reviews     Review[]
}

model Repertoire {
  id        String   @id @default(cuid())
  name      String
  color     String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
  moves  Move[]
}

model Move {
  id           String  @id @default(cuid())
  fen          String
  san          String
  fromSq       String
  toSq         String
  order        Int
  comment      String?

  parentMoveId String?
  parent       Move?   @relation("MoveTree", fields: [parentMoveId], references: [id])
  children     Move[]  @relation("MoveTree")

  repertoireId String
  repertoire   Repertoire @relation(fields: [repertoireId], references: [id])
  reviews      Review[]
}

model Review {
  id          String   @id @default(cuid())
  ease        Float    @default(2.5)
  interval    Int      @default(1)
  repetitions Int      @default(0)
  nextReview  DateTime @default(now())
  createdAt   DateTime @default(now())

  moveId String
  move   Move   @relation(fields: [moveId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])
}
